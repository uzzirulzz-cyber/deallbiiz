// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Business acquisition categories on makethisdeal.biz
model Category {
  id        String   @id @default(cuid()) @map("_id")
  name      String   @unique
  slug      String   @unique
  icon      String
  color     String
  blurb     String   @default("")
  createdAt DateTime @default(now())
}

// A business/project listed for sale or investment on the marketplace.
model Listing {
  id            String   @id @default(cuid()) @map("_id")
  title         String
  tagline       String   @default("")
  description   String
  categorySlug  String
  askingPrice   Float
  valuation     Float    @default(0)
  currency      String   @default("USD")
  annualRevenue Float    @default(0)
  annualProfit  Float    @default(0)
  revenueMultiple Float  @default(0)
  profitMultiple Float   @default(0)
  stage         String   @default("Growth")
  location      String   @default("Remote / Global")
  ageYears      Int      @default(0)
  employees     Int      @default(0)
  verified      Boolean  @default(true)
  featured      Boolean  @default(false)
  trending      Boolean  @default(false)
  imageUrl      String
  metrics       String   @default("")
  tags          String   @default("")
  url           String   @default("")
  viewCount     Int      @default(0)
  inquiryCount  Int      @default(0)
  rating        Float    @default(4.7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  savedBy       SavedListing[]
  inquiries     Inquiry[]
  orders        Order[]

  @@index([categorySlug])
  @@index([featured])
  @@index([trending])
  @@index([stage])
}

model SavedListing {
  id        String   @id @default(cuid()) @map("_id")
  sessionId String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([sessionId, listingId])
  @@index([sessionId])
}

model Inquiry {
  id        String   @id @default(cuid()) @map("_id")
  sessionId String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  message   String   @default("")
  createdAt DateTime @default(now())

  @@unique([sessionId, listingId])
  @@index([sessionId])
}

model ChatMessage {
  id        String   @id @default(cuid()) @map("_id")
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model SiteContent {
  id          String   @id @default("singleton") @map("_id")
  hero        String   @default("")
  stats       String   @default("")
  howItWorks  String   @default("")
  sections    String   @default("")
  themeColor  String   @default("#3B82F6")
  accentColor String   @default("#8B5CF6")
  brandName   String   @default("Make This Deal")
  tagline     String   @default("Together We Grow Strong")
  footerNote  String   @default("Global Enterprise Marketplace")
  updatedAt   DateTime @updatedAt
}

model Member {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  email         String   @unique
  passwordHash  String
  phone         String   @default("")
  company       String   @default("")
  role          String   @default("member")
  status        String   @default("active")
  avatarUrl     String   @default("")
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Order {
  id            String   @id @default(cuid()) @map("_id")
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])
  status        String   @default("pending")
  offerPrice    Float    @default(0)
  message       String   @default("")
  financingType String   @default("cash")
  timeline      String   @default("")
  adminNotes    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([memberId])
  @@index([listingId])
  @@index([status])
}

model PaymentSubmission {
  id             String   @id @default(cuid()) @map("_id")
  email          String
  name           String?  @default("")
  method         String
  amountPkr      Int      @default(0)
  amountUsd      Float    @default(0)
  description    String   @default("")
  transactionRef String?  @default("")
  note           String?  @default("")
  status         String   @default("pending")
  reviewedAt     DateTime?
  adminNote      String?  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([method])
  @@index([createdAt])
}
