// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Business acquisition categories on makethisdeal.biz
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   // emoji
  color     String   // accent token name
  blurb     String   @default("") // short category description
  createdAt DateTime @default(now())
  listings  Listing[]
}

// A business/project listed for sale or investment on the marketplace.
model Listing {
  id            String   @id @default(cuid())
  title         String
  tagline       String   @default("") // one-line pitch
  description   String
  categorySlug  String
  category      Category @relation(fields: [categorySlug], references: [slug])
  askingPrice   Float    // main asking price (USD)
  valuation     Float    @default(0) // independent/AI valuation estimate
  currency      String   @default("USD")
  annualRevenue Float    @default(0)
  annualProfit  Float    @default(0) // SDE / cash flow
  revenueMultiple Float  @default(0) // asking / revenue (computed)
  profitMultiple Float   @default(0) // asking / profit (computed)
  stage         String   @default("Growth") // "Startup" | "Growth" | "Established"
  location      String   @default("Remote / Global")
  ageYears      Int      @default(0)
  employees     Int      @default(0)
  verified      Boolean  @default(true)
  featured      Boolean  @default(false)
  trending      Boolean  @default(false)
  imageUrl      String
  metrics       String   @default("") // comma-separated headline metrics e.g. "1,200 customers, 4.8 NPS"
  tags          String   @default("") // comma-separated
  url           String   @default("") // outbound link / external
  viewCount     Int      @default(0)
  inquiryCount  Int      @default(0)
  rating        Float    @default(4.7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  savedBy       SavedListing[]
  inquiries     Inquiry[]
}

model SavedListing {
  id        String   @id @default(cuid())
  sessionId String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sessionId, listingId])
  @@index([sessionId])
}

model Inquiry {
  id        String   @id @default(cuid())
  sessionId String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  message   String   @default("")
  createdAt DateTime @default(now())

  @@unique([sessionId, listingId])
  @@index([sessionId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}
